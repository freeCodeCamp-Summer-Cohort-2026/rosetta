{
  "name": "rosetta",
  "version": "0.1.0",
  "private": true,
  "description": "A language-agnostic CLI for identifier case conversion, built around a pluggable stdin/stdout JSON adapter contract.",
  "bin": {
    "rosetta": "core/cli.js"
  },
  "scripts": {
    "start": "node core/cli.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
